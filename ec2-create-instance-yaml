- name: create instances using ansible
  connection: local
  hosts: local
  vars:
    subnet_id: subnet-0a4873057b1040f82
    sg_id: sg-0e614e803a234929c
    ami_id: ami-0220d79f3f480ecf5
    instance_type: t3.micro
    instances:
    - mysql
    - backend
    - frontend
  tasks: 
  - name: create ec2 instances
    amazon.aws.ec2_instance:
      name: "{{ item }}"
      subnet_id: "{{ subnet_id }}"
      security_group: "{{ sg_id }}"
      image_id: "{{ ami_id }}"
      instance_type: "{{ instance_type }}"
    loop: "{{ instances }}"